<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kraken - Local LLM</title>
  <style>
    :root {
      --bg: #ffffff;
      --panel: #f4f7ff;
      --raised: #ffffff;
      --line: #e1e8f7;
      --text: #0e1a3a;
      --muted: #667599;
      --accent: #2563ff;
      --on-accent: #ffffff;
      --danger: #e5484d;
      --ok: #16a34a;
      --code: #0b1633;
      --grad: linear-gradient(135deg, #2563ff 0%, #4f8bff 60%, #78a8ff 100%);
      --user: linear-gradient(135deg, #2563ff, #4a86ff);
      --shadow: 0 1px 2px rgba(20, 50, 120, .06), 0 10px 28px rgba(37, 99, 255, .10);
      --font: "Segoe UI Variable Text", "Segoe UI", system-ui, -apple-system, sans-serif;
      --mono: Consolas, "Cascadia Mono", monospace;
    }

    :root[data-theme="dark"] {
      --bg: #060c1e;
      --panel: #0a1330;
      --raised: #101c42;
      --line: #1a2a5c;
      --text: #e8eeff;
      --muted: #8d9cd0;
      --accent: #4f86ff;
      --ok: #34d399;
      --code: #050a1c;
      --grad: linear-gradient(135deg, #3b74ff 0%, #5f93ff 60%, #8ab4ff 100%);
      --user: linear-gradient(135deg, #2f66f0, #4f86ff);
      --shadow: 0 10px 30px rgba(0, 0, 0, .4);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0
    }

    html,
    body {
      height: 100%
    }

    body {
      font-family: var(--font);
      background: var(--bg);
      color: var(--text);
      display: flex;
      overflow: hidden;
      font-size: 15px
    }

    button,
    input,
    select,
    textarea {
      font: inherit;
      color: inherit
    }

    button {
      cursor: pointer;
      background: none;
      border: none
    }

    :focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px
    }

    svg {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round
    }

    ::-webkit-scrollbar {
      width: 8px
    }

    ::-webkit-scrollbar-thumb {
      background: var(--line);
      border-radius: 8px
    }

    .grad {
      background: var(--grad);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent
    }

    /* Sidebar */
    .sidebar {
      width: 276px;
      background: var(--panel);
      border-right: 1px solid var(--line);
      display: flex;
      flex-direction: column;
      padding: 20px 14px 14px;
      gap: 14px;
      flex-shrink: 0
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 11px;
      font-weight: 700;
      font-size: 1.2rem;
      letter-spacing: -.01em;
      padding: 0 6px
    }

    .logo {
      width: 34px;
      height: 34px;
      border-radius: 11px;
      background: var(--grad);
      color: #fff;
      display: grid;
      place-items: center;
      box-shadow: 0 6px 16px rgba(37, 99, 255, .35)
    }

    .logo svg {
      width: 21px;
      height: 21px
    }

    .new-chat {
      display: flex;
      align-items: center;
      gap: 10px;
      background: var(--grad);
      color: var(--on-accent);
      font-weight: 600;
      padding: 12px 16px;
      border-radius: 14px;
      box-shadow: 0 8px 20px rgba(37, 99, 255, .28);
      transition: transform .15s, box-shadow .15s
    }

    .new-chat:hover {
      transform: translateY(-1px);
      box-shadow: 0 12px 26px rgba(37, 99, 255, .36)
    }

    .search {
      display: flex;
      align-items: center;
      gap: 8px;
      background: var(--raised);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 9px 12px;
      color: var(--muted)
    }

    .search input {
      flex: 1;
      background: none;
      border: none;
      outline: none;
      font-size: .88rem;
      color: var(--text);
      min-width: 0
    }

    .search:focus-within {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 15%, transparent)
    }

    .list {
      flex: 1;
      overflow-y: auto;
      margin: 0 -6px;
      padding: 0 6px;
      display: flex;
      flex-direction: column;
      gap: 3px
    }

    .item {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 10px 12px;
      border-radius: 12px;
      color: var(--muted);
      font-size: .9rem;
      cursor: pointer;
      transition: background .15s
    }

    .item span {
      flex: 1;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis
    }

    .item:hover {
      background: color-mix(in srgb, var(--accent) 8%, transparent);
      color: var(--text)
    }

    .item.active {
      background: var(--raised);
      color: var(--accent);
      font-weight: 600;
      box-shadow: var(--shadow)
    }

    .item .del {
      opacity: 0;
      padding: 3px;
      border-radius: 6px;
      color: var(--muted)
    }

    .item .del svg {
      width: 15px;
      height: 15px
    }

    .item:hover .del,
    .item .del:focus-visible {
      opacity: 1
    }

    .item .del:hover {
      color: var(--danger)
    }

    .none {
      color: var(--muted);
      font-size: .85rem;
      padding: 10px
    }

    .foot {
      border-top: 1px solid var(--line);
      padding-top: 12px;
      display: flex;
      flex-direction: column;
      gap: 2px
    }

    .foot button {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 12px;
      border-radius: 12px;
      color: var(--muted);
      font-size: .9rem;
      text-align: left
    }

    .foot button:hover {
      background: color-mix(in srgb, var(--accent) 8%, transparent);
      color: var(--text)
    }

    /* Main */
    .main {
      flex: 1;
      display: flex;
      flex-direction: column;
      min-width: 0;
      position: relative;
      background: radial-gradient(70% 45% at 50% 0%, color-mix(in srgb, var(--accent) 9%, transparent), transparent)
    }

    .top {
      height: 60px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 28px;
      gap: 16px
    }

    .title {
      font-weight: 650;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis
    }

    .status {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: .82rem;
      color: var(--muted);
      background: var(--raised);
      border: 1px solid var(--line);
      padding: 6px 13px;
      border-radius: 99px;
      white-space: nowrap;
      box-shadow: var(--shadow)
    }

    .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--danger)
    }

    .dot.on {
      background: var(--ok);
      animation: pulse 2.4s infinite
    }

    @keyframes pulse {
      0% {
        box-shadow: 0 0 0 0 color-mix(in srgb, var(--ok) 55%, transparent)
      }

      70%,
      100% {
        box-shadow: 0 0 0 7px transparent
      }
    }

    .chat {
      flex: 1;
      overflow-y: auto;
      padding: 20px 0 12px;
      scroll-behavior: smooth
    }

    .col {
      max-width: 800px;
      margin: 0 auto;
      padding: 0 28px;
      display: flex;
      flex-direction: column;
      gap: 28px
    }

    .msg {
      display: flex;
      gap: 14px;
      line-height: 1.7
    }

    .msg.user {
      justify-content: flex-end
    }

    .msg.user .body {
      background: var(--user);
      color: #fff;
      padding: 12px 19px;
      border-radius: 20px 20px 5px 20px;
      max-width: 80%;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
      box-shadow: 0 8px 20px rgba(37, 99, 255, .22)
    }

    .avatar {
      width: 32px;
      height: 32px;
      border-radius: 10px;
      background: var(--grad);
      display: grid;
      place-items: center;
      color: #fff;
      flex-shrink: 0;
      box-shadow: 0 5px 14px rgba(37, 99, 255, .3)
    }

    .avatar svg {
      width: 19px;
      height: 19px
    }

    .msg.ai .body {
      flex: 1;
      min-width: 0;
      overflow-wrap: anywhere
    }

    .who {
      font-size: .78rem;
      color: var(--muted);
      margin-bottom: 3px;
      font-weight: 600
    }

    .actions {
      display: flex;
      gap: 2px;
      margin-top: 8px;
      margin-left: -8px
    }

    .copy {
      font-size: .8rem;
      color: var(--muted);
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 9px;
      border-radius: 8px
    }

    .copy:hover {
      color: var(--accent);
      background: color-mix(in srgb, var(--accent) 10%, transparent)
    }

    .copy svg {
      width: 15px;
      height: 15px
    }

    .typing {
      display: inline-flex;
      gap: 5px;
      padding: 10px 0
    }

    .typing i {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--accent);
      animation: bob 1.2s infinite ease-in-out
    }

    .typing i:nth-child(2) {
      animation-delay: .15s
    }

    .typing i:nth-child(3) {
      animation-delay: .3s
    }

    @keyframes bob {

      0%,
      60%,
      100% {
        opacity: .25;
        transform: translateY(0)
      }

      30% {
        opacity: 1;
        transform: translateY(-4px)
      }
    }

    .content code {
      font-family: var(--mono);
      background: color-mix(in srgb, var(--accent) 10%, transparent);
      color: var(--accent);
      padding: 1px 6px;
      border-radius: 6px;
      font-size: .88em
    }

    .code {
      margin: 12px 0;
      border-radius: 14px;
      overflow: hidden;
      background: var(--code);
      border: 1px solid var(--line);
      box-shadow: var(--shadow)
    }

    .chead {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 6px 8px 6px 14px;
      background: rgba(255, 255, 255, .07);
      color: #9db2e8;
      font-size: .78rem;
      font-family: var(--mono)
    }

    .cbtns {
      display: flex;
      gap: 2px
    }

    .cbtn {
      color: #9db2e8;
      font-size: .78rem;
      padding: 4px 10px;
      border-radius: 6px;
      font-family: var(--font)
    }

    .cbtn:hover {
      background: rgba(255, 255, 255, .12);
      color: #fff
    }

    .content pre {
      padding: 14px 16px;
      overflow-x: auto;
      font-size: .86rem;
      line-height: 1.6;
      color: #d6e2ff
    }

    .content pre code {
      background: none;
      border: none;
      padding: 0;
      color: inherit;
      font-size: inherit
    }

    .tk-k {
      color: #c792ea
    }

    .tk-s {
      color: #a5d66f
    }

    .tk-n {
      color: #ff9e64
    }

    .tk-c {
      color: #6b7fb0;
      font-style: italic
    }

    .tk-f {
      color: #7aa8ff
    }

    .tk-y {
      color: #4fd8e8
    }

    .tk-t {
      color: #f7768e
    }

    .tk-a {
      color: #e0af68
    }

    .err {
      color: var(--danger)
    }

    .h {
      font-weight: 700;
      font-size: 1.06rem;
      margin: 14px 0 2px
    }

    /* Empty state */
    .empty {
      margin: 8vh auto 0;
      max-width: 760px;
      padding: 0 28px;
      text-align: center
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: .8rem;
      color: var(--accent);
      background: color-mix(in srgb, var(--accent) 10%, transparent);
      border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
      padding: 5px 13px;
      border-radius: 99px;
      font-weight: 600
    }

    .badge svg {
      width: 14px;
      height: 14px
    }

    .empty h1 {
      font-size: 2.5rem;
      font-weight: 750;
      letter-spacing: -.03em;
      line-height: 1.12;
      margin-top: 20px
    }

    .empty p {
      color: var(--muted);
      margin: 14px auto 0;
      max-width: 480px;
      line-height: 1.6
    }

    .chips {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 12px;
      margin-top: 38px
    }

    .chip {
      text-align: left;
      display: flex;
      flex-direction: column;
      gap: 12px;
      background: var(--raised);
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 16px;
      line-height: 1.45;
      font-size: .9rem;
      box-shadow: 0 1px 2px rgba(20, 50, 120, .04);
      transition: transform .15s, border-color .15s, box-shadow .15s
    }

    .chip:hover {
      transform: translateY(-3px);
      border-color: color-mix(in srgb, var(--accent) 50%, var(--line));
      box-shadow: var(--shadow)
    }

    .chip svg {
      color: var(--accent);
      width: 20px;
      height: 20px
    }

    /* Composer */
    .composer {
      padding: 8px 28px 18px
    }

    .box {
      max-width: 800px;
      margin: 0 auto;
      background: var(--raised);
      border: 1px solid var(--line);
      border-radius: 24px;
      padding: 14px 14px 12px 20px;
      box-shadow: var(--shadow);
      transition: border-color .2s, box-shadow .2s
    }

    .box:focus-within {
      border-color: var(--accent);
      box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 14%, transparent), var(--shadow)
    }

    #input {
      display: block;
      width: 100%;
      background: none;
      border: none;
      outline: none;
      resize: none;
      line-height: 24px;
      height: 24px;
      max-height: 160px;
      padding: 4px 0
    }

    #input::placeholder {
      color: var(--muted)
    }

    .row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 10px;
      gap: 10px
    }

    .models {
      display: flex;
      align-items: center;
      gap: 6px;
      color: var(--accent);
      background: color-mix(in srgb, var(--accent) 9%, transparent);
      border-radius: 10px;
      padding: 3px 6px 3px 9px
    }

    #model {
      background: none;
      border: none;
      border-radius: 8px;
      padding: 4px 4px;
      font-size: .85rem;
      outline: none;
      max-width: 220px;
      font-weight: 600;
      color: var(--accent);
      cursor: pointer
    }

    #model option {
      background: var(--raised);
      color: var(--text)
    }

    .send {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: var(--grad);
      color: var(--on-accent);
      display: grid;
      place-items: center;
      box-shadow: 0 6px 16px rgba(37, 99, 255, .35);
      transition: transform .15s
    }

    .send:hover:not(:disabled) {
      transform: scale(1.08)
    }

    .send:disabled {
      background: var(--line);
      color: var(--muted);
      cursor: not-allowed;
      box-shadow: none
    }

    .send.stop {
      background: var(--danger);
      color: #fff;
      display: none;
      box-shadow: none
    }

    .send svg {
      width: 16px;
      height: 16px;
      fill: currentColor;
      stroke: none
    }

    .note {
      text-align: center;
      font-size: .76rem;
      color: var(--muted);
      margin-top: 10px
    }

    /* Modal */
    .overlay {
      position: fixed;
      inset: 0;
      background: rgba(8, 18, 50, .45);
      display: none;
      place-items: center;
      z-index: 10;
      backdrop-filter: blur(4px)
    }

    .overlay.on {
      display: grid
    }

    .modal {
      background: var(--raised);
      border: 1px solid var(--line);
      border-radius: 20px;
      padding: 26px;
      width: 92%;
      max-width: 450px;
      box-shadow: 0 24px 60px rgba(8, 18, 50, .3)
    }

    .mh {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-weight: 700;
      font-size: 1.15rem;
      margin-bottom: 6px
    }

    .mh button {
      color: var(--muted)
    }

    .modal p {
      color: var(--muted);
      font-size: .87rem;
      margin-bottom: 16px
    }

    .field {
      width: 100%;
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 12px 14px;
      outline: none
    }

    .field:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 15%, transparent)
    }

    .suggest {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin: 12px 0 18px
    }

    .suggest button {
      font-size: .8rem;
      border: 1px solid var(--line);
      border-radius: 99px;
      padding: 4px 13px;
      color: var(--muted)
    }

    .suggest button:hover {
      border-color: var(--accent);
      color: var(--accent);
      background: color-mix(in srgb, var(--accent) 8%, transparent)
    }

    .pull {
      width: 100%;
      background: var(--grad);
      color: var(--on-accent);
      font-weight: 600;
      padding: 12px;
      border-radius: 12px;
      box-shadow: 0 8px 20px rgba(37, 99, 255, .28)
    }

    .pull:disabled {
      opacity: .5;
      cursor: not-allowed
    }

    .bar {
      height: 6px;
      background: var(--line);
      border-radius: 3px;
      overflow: hidden;
      margin-top: 16px;
      display: none
    }

    .bar div {
      height: 100%;
      width: 0;
      background: var(--grad);
      transition: width .2s
    }

    .ptext {
      font-size: .8rem;
      color: var(--muted);
      margin-top: 8px;
      text-align: center;
      display: none
    }

    [hidden] {
      display: none !important
    }

    .right {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 0
    }

    .stats {
      display: flex;
      align-items: center;
      gap: 16px;
      background: var(--raised);
      border: 1px solid var(--line);
      border-radius: 99px;
      padding: 6px 16px;
      box-shadow: var(--shadow)
    }

    .stat {
      display: flex;
      align-items: center;
      gap: 7px;
      font-size: .78rem;
      color: var(--muted);
      white-space: nowrap
    }

    .sl {
      font-weight: 700;
      font-size: .7rem;
      letter-spacing: .04em;
      color: var(--text)
    }

    .meter {
      width: 42px;
      height: 5px;
      background: var(--line);
      border-radius: 3px;
      overflow: hidden
    }

    .meter i {
      display: block;
      height: 100%;
      width: 0;
      background: var(--grad);
      border-radius: 3px;
      transition: width .6s
    }

    .stat.hot .meter i {
      background: linear-gradient(90deg, #f59e0b, #ef4444)
    }

    .sv {
      font-variant-numeric: tabular-nums
    }

    @media(max-width:1150px) {
      .meter {
        display: none
      }
    }

    @media(max-width:900px) {
      .stats {
        display: none
      }
    }

    @media(max-width:760px) {
      .sidebar {
        display: none
      }

      .top,
      .composer,
      .col {
        padding-left: 16px;
        padding-right: 16px
      }
    }

    @media(prefers-reduced-motion:reduce) {
      * {
        animation: none !important;
        transition: none !important
      }
    }
  </style>
</head>

<body>
  <aside class="sidebar">
    <div class="brand"><span class="logo"><svg viewBox="0 0 24 24">
          <path
            d="M5 12a7 7 0 0 1 14 0v2.5c0 1.2-.8 2-1.8 2s-1.7-.8-1.7-2M5 12v2.5c0 2.5-1 4-2.5 5M9.5 14v6M14 14.5c0 2.5 1 4.2 3.2 5.5" />
          <circle cx="9.5" cy="10.5" r=".6" />
          <circle cx="14.5" cy="10.5" r=".6" />
        </svg></span>Kraken</div>
    <button class="new-chat" id="new-chat"><svg viewBox="0 0 24 24">
        <path d="M12 5v14M5 12h14" />
      </svg>New chat</button>
    <label class="search"><svg viewBox="0 0 24 24" style="width:16px;height:16px">
        <circle cx="11" cy="11" r="7" />
        <path d="m21 21-4.3-4.3" />
      </svg><input id="search" placeholder="Search chats" aria-label="Search chats"></label>
    <div class="list" id="list"></div>
    <div class="foot">
      <button id="models-btn"><svg viewBox="0 0 24 24">
          <path d="M12 3 3 8l9 5 9-5-9-5Z" />
          <path d="m3 13 9 5 9-5" />
        </svg>Manage models</button>
      <button id="export-btn"><svg viewBox="0 0 24 24">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" />
        </svg><span>Export chat</span></button>
      <button id="theme-btn"><svg viewBox="0 0 24 24">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
        </svg><span id="theme-label">Switch theme</span></button>
    </div>
  </aside>

  <main class="main">
    <header class="top">
      <div class="title" id="title">New chat</div>
      <div class="right">
        <div class="stats" id="stats" hidden>
          <div class="stat" id="st-cpu"><span class="sl">CPU</span><span class="meter"><i></i></span><span
              class="sv"></span></div>
          <div class="stat" id="st-ram"><span class="sl">RAM</span><span class="meter"><i></i></span><span
              class="sv"></span></div>
          <div class="stat" id="st-gpu" hidden><span class="sl">GPU</span><span class="meter"><i></i></span><span
              class="sv"></span></div>
          <div class="stat" id="st-vram" hidden><span class="sl">VRAM</span><span class="meter"><i></i></span><span
              class="sv"></span></div>
        </div>
        <div class="status"><span class="dot" id="dot"></span><span id="status-text">Checking Ollama</span></div>
      </div>
    </header>
    <div class="chat" id="chat"></div>
    <div class="composer">
      <div class="box">
        <textarea id="input" rows="1" placeholder="Message your local model" aria-label="Message"></textarea>
        <div class="row">
          <div class="models"><svg viewBox="0 0 24 24" style="width:16px;height:16px">
              <rect x="4" y="4" width="16" height="16" rx="3" />
              <path d="M9 9h6v6H9z" />
            </svg>
            <select id="model" aria-label="Model">
              <option value="" disabled selected>Select model</option>
            </select>
          </div>
          <div>
            <button class="send" id="send" disabled aria-label="Send"><svg viewBox="0 0 24 24">
                <path d="M3 20.5 21 12 3 3.5l.01 6.7L15 12 3 13.8Z" />
              </svg></button>
            <button class="send stop" id="stop" aria-label="Stop"><svg viewBox="0 0 24 24">
                <rect x="6" y="6" width="12" height="12" rx="2" />
              </svg></button>
          </div>
        </div>
      </div>
      <div class="note">Runs on this computer. Local models can make mistakes, so check important facts.</div>
    </div>
  </main>

  <div class="overlay" id="modal">
    <div class="modal" role="dialog" aria-label="Manage models">
      <div class="mh">Download a model <button id="close-modal" aria-label="Close"><svg viewBox="0 0 24 24">
            <path d="M18 6 6 18M6 6l12 12" />
          </svg></button></div>
      <p>Enter a model name from the Ollama library. It downloads to this computer.</p>
      <input class="field" id="model-name" placeholder="e.g. llama3.2">
      <div class="suggest" id="suggest">
        <button>llama3.2</button><button>qwen2.5</button><button>mistral</button><button>gemma2</button>
      </div>
      <button class="pull" id="pull">Download model</button>
      <div class="bar" id="bar">
        <div id="bar-fill"></div>
      </div>
      <div class="ptext" id="ptext"></div>
    </div>
  </div>

  <script>
    const $ = id => document.getElementById(id);
    const OLLAMA_URL = 'http://127.0.0.1:11434';
    const KEY = 'kraken_chats', ICON = $('new-chat').previousElementSibling.querySelector('svg').outerHTML;
    const SPARK = '<svg viewBox="0 0 24 24"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3Z"/><path d="M19 16v4M17 18h4"/></svg>';
    const SUGGESTIONS = ['Explain how a neural network learns, in simple words', 'Write a Python function that checks if a string is a palindrome', 'Help me plan a 4-week study schedule for exams'];

    let chats = [], activeId = null, online = false, busy = false, abortCtl = null;
    let gen = null, live = null; // gen = reply being generated {chatId,text,model}; live = its on-screen element

    /* ---------- storage ---------- */
    function load() {
      try { chats = JSON.parse(localStorage.getItem(KEY)) || []; } catch { chats = []; }
      const old = localStorage.getItem('localLLMChat'); // migrate the single chat from the old version
      if (!chats.length && old) {
        try { const m = JSON.parse(old); if (m.length) chats.push(newChat(m)); } catch { }
        try { localStorage.removeItem('localLLMChat'); } catch { }
      }
      chats.sort((a, b) => b.updated - a.updated);
      activeId = null;
    }
    const save = () => { try { localStorage.setItem(KEY, JSON.stringify(chats.filter(c => c.messages.length))); } catch { } };
    const uid = () => Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
    function newChat(messages = []) {
      return { id: uid(), title: messages[0] ? messages[0].content.slice(0, 40) : 'New chat', messages, updated: Date.now() };
    }
    const current = () => chats.find(c => c.id === activeId);

    /* ---------- rendering ---------- */
    const esc = s => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    function md(text) {
      return text.split(/(```[\s\S]*?(?:```|$))/g).map(part => {
        if (part.startsWith('```')) {
          const lang = (part.match(/^```([\w+#.-]*)/) || [])[1] || '';
          const code = part.replace(/^```[^\n]*\n?/, '').replace(/```$/, '').replace(/\n$/, '');
          const ext = EXT[lang.toLowerCase()] || 'txt';
          return `<div class="code"><div class="chead"><span>${esc(lang || 'code')}</span><span class="cbtns"><button class="cbtn" data-act="copy">Copy</button><button class="cbtn" data-act="dl" data-ext="${ext}">Download</button></span></div><pre><code>${highlight(code, lang)}</code></pre></div>`;
        }
        return esc(part).replace(/`([^`\n]+)`/g, '<code>$1</code>').replace(/\*\*([^*\n]+)\*\*/g, '<strong>$1</strong>').replace(/^#{1,4} +(.+)(\n|$)/gm, '<div class="h">$1</div>').replace(/\n/g, '<br>');
      }).join('');
    }

    function renderList() {
      const q = $('search').value.trim().toLowerCase();
      const items = chats.filter(c => c.messages.length && c.title.toLowerCase().includes(q)).sort((a, b) => b.updated - a.updated);
      $('list').innerHTML = '';
      if (!items.length) { $('list').innerHTML = `<div class="none">${q ? 'No chats match.' : 'Your chats will show up here.'}</div>`; return; }
      items.forEach(c => {
        const el = document.createElement('div');
        el.className = 'item' + (c.id === activeId ? ' active' : '');
        el.tabIndex = 0;
        el.innerHTML = `<span>${esc(c.title)}</span><button class="del" aria-label="Delete chat"><svg viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/></svg></button>`;
        el.onclick = () => { activeId = c.id; renderAll(); };
        el.onkeydown = e => { if (e.key === 'Enter') el.click(); };
        el.querySelector('.del').onclick = e => {
          e.stopPropagation();
          if (gen && gen.chatId === c.id && abortCtl) abortCtl.abort();
          chats = chats.filter(x => x.id !== c.id);
          if (activeId === c.id) activeId = chats[0]?.id || null;
          save(); renderAll();
        };
        $('list').appendChild(el);
      });
    }

    function aiMessage(text, model) {
      const el = document.createElement('div');
      el.className = 'msg ai';
      el.innerHTML = `<div class="avatar">${ICON}</div><div class="body"><div class="who">${esc(model || 'Kraken')}</div><div class="content"></div></div>`;
      const content = el.querySelector('.content');
      if (text) content.innerHTML = md(text);
      return el;
    }
    /* ---------- code highlighting (offline, no libraries) ---------- */
    const EXT = { python: 'py', py: 'py', javascript: 'js', js: 'js', jsx: 'jsx', typescript: 'ts', ts: 'ts', tsx: 'tsx', html: 'html', css: 'css', json: 'json', java: 'java', c: 'c', cpp: 'cpp', 'c++': 'cpp', csharp: 'cs', 'c#': 'cs', cs: 'cs', go: 'go', rust: 'rs', rs: 'rs', php: 'php', bash: 'sh', sh: 'sh', shell: 'sh', powershell: 'ps1', ps1: 'ps1', sql: 'sql', yaml: 'yml', yml: 'yml', ruby: 'rb', rb: 'rb', kotlin: 'kt', swift: 'swift', xml: 'xml', markdown: 'md', md: 'md' };
    const KW = new Set(('abstract and as assert async await break case catch class const continue def default del do elif else enum except export extends False final finally fn for foreach from func function global goto if implements import in instanceof interface is lambda let match namespace new nil None not null of or package pass private protected public raise return self static struct super switch template this throw throws True true false try typeof undefined union unsafe use using var void volatile while with yield echo fi then done esac select insert update delete create table where join group order by limit values set into alter drop index primary key foreign references distinct having as on inner left right outer').split(' '));
    const TYPES = new Set('int float double char bool boolean str string long short byte i8 i16 i32 i64 u8 u16 u32 u64 usize isize f32 f64 number any object list dict tuple var'.split(' '));
    function highlight(code, lang) {
      lang = (lang || '').toLowerCase();
      const S = String.raw;
      const isHtml = /^(html|xml|svg|vue)$/.test(lang), isSql = lang === 'sql';
      const hash = /^(py|python|sh|bash|shell|zsh|yaml|yml|ruby|rb|toml|ps1|powershell|r|perl)$/.test(lang);
      const comment = isHtml ? S`<!--[\s\S]*?(?:-->|$)` : hash ? '#.*' : isSql ? '--.*' : S`\/\/.*|\/\*[\s\S]*?(?:\*\/|$)`;
      const str = S`"""[\s\S]*?(?:"""|$)|'''[\s\S]*?(?:'''|$)|"(?:\\.|[^"\\\n])*"?|'(?:\\.|[^'\\\n])*'?|` + '`(?:\\\\.|[^`\\\\])*`?';
      const tag = isHtml ? S`<\/?[A-Za-z][\w:-]*|\/?>` : '(?!)';
      const num = S`\b0x[\da-fA-F]+\b|\b\d+(?:\.\d+)?\b`;
      const word = S`[A-Za-z_$][\w$]*`;
      const re = new RegExp([comment, str, tag, num, word].map(p => '(' + p + ')').join('|'), 'g');
      let out = '', last = 0, m;
      while ((m = re.exec(code))) {
        const t = m[0];
        out += esc(code.slice(last, m.index));
        let cls = '';
        if (m[1]) cls = 'c';
        else if (m[2]) cls = 's';
        else if (m[3]) cls = 't';
        else if (m[4]) cls = 'n';
        else {
          const w = isSql ? t.toLowerCase() : t, next = code[re.lastIndex];
          if (KW.has(w)) cls = 'k';
          else if (isHtml && next === '=') cls = 'a';
          else if (next === '(') cls = 'f';
          else if (TYPES.has(t) || /^[A-Z][a-z]/.test(t)) cls = 'y';
        }
        out += cls ? `<span class="tk-${cls}">${esc(t)}</span>` : esc(t);
        last = re.lastIndex;
      }
      return out + esc(code.slice(last));
    }

    /* ---------- copy / save helpers ---------- */
    async function copyText(text) {
      try { await navigator.clipboard.writeText(text); return true; } catch { }
      try { // fallback for desktop webviews where the clipboard API is blocked
        const t = document.createElement('textarea');
        t.value = text; t.style.cssText = 'position:fixed;opacity:0';
        document.body.appendChild(t); t.select();
        const ok = document.execCommand('copy'); t.remove(); return ok;
      } catch { return false; }
    }
    // Saves through Python's "Save as" dialog when running in the desktop app, or a normal download in a browser
    async function saveFile(name, text) {
      if (window.pywebview && window.pywebview.api && window.pywebview.api.save_file) {
        try { return await window.pywebview.api.save_file(name, text); } catch (e) { console.error(e); }
      }
      const url = URL.createObjectURL(new Blob([text], { type: 'text/plain' }));
      const a = document.createElement('a');
      a.href = url; a.download = name;
      document.body.appendChild(a); a.click(); a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 2000);
      return true;
    }
    function flash(el, label) {
      const t = el.querySelector('.lbl') || el;
      if (!t.dataset.o) t.dataset.o = t.textContent;
      t.textContent = label;
      clearTimeout(t._t);
      t._t = setTimeout(() => { t.textContent = t.dataset.o; }, 1500);
    }

    // Buttons inside code blocks
    $('chat').addEventListener('click', async e => {
      const b = e.target.closest('.cbtn');
      if (!b) return;
      const code = b.closest('.code').querySelector('code').textContent;
      if (b.dataset.act === 'copy') flash(b, (await copyText(code)) ? 'Copied' : 'Failed');
      else if ((await saveFile('kraken_code.' + b.dataset.ext, code)) !== false) flash(b, 'Saved');
    });

    // Buttons at the end of each reply
    function addCopy(el, getText) {
      const bar = document.createElement('div');
      bar.className = 'actions';
      bar.innerHTML =
        '<button class="copy" data-m="copy"><svg viewBox="0 0 24 24"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h8"/></svg><span class="lbl">Copy</span></button>' +
        '<button class="copy" data-m="dl"><svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg><span class="lbl">Download</span></button>';
      bar.onclick = async e => {
        const b = e.target.closest('button');
        if (!b) return;
        if (b.dataset.m === 'copy') flash(b, (await copyText(getText())) ? 'Copied' : 'Failed');
        else if ((await saveFile('kraken_reply.md', getText())) !== false) flash(b, 'Saved');
      };
      el.querySelector('.body').appendChild(bar);
    }
    function userMessage(text) {
      const el = document.createElement('div');
      el.className = 'msg user';
      el.innerHTML = '<div class="body"></div>';
      el.firstChild.textContent = text;
      return el;
    }

    function renderChat() {
      const chat = current(), box = $('chat');
      box.innerHTML = ''; live = null;
      $('title').textContent = chat && chat.messages.length ? chat.title : 'New chat';
      if (!chat || !chat.messages.length) {
        box.innerHTML = `<div class="empty"><span class="badge">${SPARK}Private. Runs on your computer</span><h1>What do you want to <span class="grad">create today?</span></h1><p>Ask questions, write code or plan your work. Pick a model below and start typing.</p><div class="chips"></div></div>`;
        SUGGESTIONS.forEach(s => {
          const b = document.createElement('button');
          b.className = 'chip'; b.innerHTML = SPARK + '<span></span>'; b.lastChild.textContent = s;
          b.onclick = () => { $('input').value = s; resizeInput(); updateSend(); $('input').focus(); };
          box.querySelector('.chips').appendChild(b);
        });
        return;
      }
      const col = document.createElement('div');
      col.className = 'col'; col.id = 'col';
      chat.messages.forEach(m => {
        if (m.role === 'user') col.appendChild(userMessage(m.content));
        else if (m.err) { const el = aiMessage('', m.model); el.querySelector('.content').innerHTML = '<span class="err">Could not reach Ollama. Check that it is running, then try again.</span>'; col.appendChild(el); }
        else { const el = aiMessage(m.content, m.model); addCopy(el, () => m.content); col.appendChild(el); }
      });
      if (gen && gen.chatId === chat.id) {
        const el = aiMessage(gen.text, gen.model);
        live = el.querySelector('.content');
        if (!gen.text) live.innerHTML = '<span class="typing"><i></i><i></i><i></i></span>';
        col.appendChild(el);
      }
      box.appendChild(col);
      box.scrollTop = box.scrollHeight;
    }
    function renderAll() { renderList(); renderChat(); }

    /* ---------- ollama connection ---------- */
    function updateSend() {
      const ready = online && !busy && $('input').value.trim() && $('model').value;
      $('send').disabled = !ready;
      $('send').style.display = busy ? 'none' : 'grid';
      $('stop').style.display = busy ? 'grid' : 'none';
    }
    async function checkOllama() {
      try {
        const res = await fetch(`${OLLAMA_URL}/api/tags`);
        if (!res.ok) throw 0;
        if (!online) { online = true; setStatus(true); await fetchModels(); warmUp(); }
      } catch {
        if (online) { online = false; warmed = ''; setStatus(false); $('model').innerHTML = '<option value="" disabled selected>Offline</option>'; }
        else setStatus(false);
      }
      updateSend();
    }
    function setStatus(on) {
      $('dot').classList.toggle('on', on);
      $('status-text').textContent = on ? 'Ollama connected' : 'Ollama offline';
    }
    let warmed = '';
    // An empty request makes Ollama load the model into memory ahead of the first message
    async function warmUp() {
      const m = $('model').value;
      if (!online || !m || warmed === m) return;
      warmed = m;
      $('status-text').textContent = 'Loading model...';
      try {
        await fetch(`${OLLAMA_URL}/api/generate`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ model: m, keep_alive: '30m' })
        });
      } catch { }
      if (online) $('status-text').textContent = 'Ollama connected';
    }
    async function fetchModels() {
      try {
        const { models = [] } = await (await fetch(`${OLLAMA_URL}/api/tags`)).json();
        const keep = $('model').value;
        $('model').innerHTML = '';
        if (!models.length) { $('model').innerHTML = '<option value="" disabled selected>No models yet</option>'; return; }
        models.forEach(m => { const o = document.createElement('option'); o.value = m.name; o.textContent = m.name; $('model').appendChild(o); });
        $('model').value = models.find(m => m.name === keep) ? keep : models[0].name;
        updateSend();
      } catch (e) { console.error('Failed to fetch models', e); }
    }

    // Reads Ollama's newline-delimited JSON stream, keeping partial lines between chunks
    async function* readNdjson(res) {
      const reader = res.body.getReader(), dec = new TextDecoder();
      let buf = '';
      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        buf += dec.decode(value, { stream: true });
        const lines = buf.split('\n');
        buf = lines.pop();
        for (const l of lines) if (l.trim()) { try { yield JSON.parse(l); } catch { } }
      }
    }

    async function sendMessage() {
      const text = $('input').value.trim(), model = $('model').value;
      if (!text || !model || busy) return;
      let chat = current();
      if (!chat) { chat = newChat(); chats.unshift(chat); activeId = chat.id; }
      if (!chat.messages.length) chat.title = text.slice(0, 40);
      chat.messages.push({ role: 'user', content: text });
      chat.updated = Date.now();
      save();
      $('input').value = ''; resizeInput();

      // The reply is tracked by chat id, so you can switch chats while it is still generating
      gen = { chatId: chat.id, text: '', model };
      busy = true; abortCtl = new AbortController(); updateSend();
      renderAll();

      let failed = false;
      try {
        const res = await fetch(`${OLLAMA_URL}/api/chat`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            model,
            messages: chat.messages.filter(m => !m.err).map(({ role, content }) => ({ role, content })),
            stream: true,
            keep_alive: '30m'
          }),
          signal: abortCtl.signal
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        for await (const data of readNdjson(res)) {
          if (data.message?.content) {
            gen.text += data.message.content;
            if (live && live.isConnected) { // only paint if this chat is on screen
              live.innerHTML = md(gen.text);
              $('chat').scrollTop = $('chat').scrollHeight;
            }
          }
        }
      } catch (err) {
        if (err.name !== 'AbortError') failed = true;
      } finally {
        const reply = gen.text;
        gen = null; live = null; busy = false; abortCtl = null;
        if (reply) chat.messages.push({ role: 'assistant', content: reply, model });
        else if (failed) chat.messages.push({ role: 'assistant', content: '', model, err: true });
        chat.updated = Date.now();
        save(); updateSend(); renderList();
        if (activeId === chat.id) renderChat();
      }
    }

    /* ---------- events ---------- */
    function resizeInput() { const t = $('input'); t.style.height = '24px'; t.style.height = Math.min(t.scrollHeight, 160) + 'px'; }
    $('input').addEventListener('input', () => { resizeInput(); updateSend(); });
    $('input').addEventListener('keydown', e => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); if (!$('send').disabled) sendMessage(); } });
    $('model').addEventListener('change', () => { updateSend(); warmUp(); });
    $('send').onclick = sendMessage;
    $('stop').onclick = () => abortCtl && abortCtl.abort();
    $('search').addEventListener('input', renderList);
    $('new-chat').onclick = () => {
      const c = current();
      if (!c || c.messages.length) { const n = newChat(); chats.unshift(n); activeId = n.id; }
      renderAll(); $('input').focus();
    };
    $('export-btn').onclick = async () => {
      const c = current(), label = $('export-btn').querySelector('span');
      if (!c || !c.messages.length) return flash(label, 'Nothing to export');
      const text = `# ${c.title}\n\n` + c.messages.map(m => `### ${m.role === 'user' ? 'You' : (m.model || 'Kraken')}\n\n${m.content}`).join('\n\n---\n\n') + '\n';
      const name = 'kraken_' + (c.title.replace(/[^\w]+/g, '_').slice(0, 30) || 'chat') + '.md';
      if ((await saveFile(name, text)) !== false) flash(label, 'Exported');
    };

    /* theme */
    function setTheme(t) {
      document.documentElement.dataset.theme = t;
      $('theme-label').textContent = t === 'dark' ? 'Light mode' : 'Dark mode';
      try { localStorage.setItem('kraken_theme2', t); } catch { }
    }
    $('theme-btn').onclick = () => setTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark');

    /* model download modal */
    const openModal = () => $('modal').classList.add('on'), closeModal = () => $('modal').classList.remove('on');
    $('models-btn').onclick = openModal;
    $('close-modal').onclick = closeModal;
    $('modal').onclick = e => { if (e.target === $('modal')) closeModal(); };
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });
    $('suggest').onclick = e => { if (e.target.tagName === 'BUTTON') $('model-name').value = e.target.textContent; };

    function resetModal() {
      $('model-name').value = ''; $('bar').style.display = $('ptext').style.display = 'none';
      $('bar-fill').style.width = '0'; $('bar-fill').style.background = '';
    }
    $('pull').onclick = async () => {
      const name = $('model-name').value.trim();
      if (!name) return;
      $('pull').disabled = $('model-name').disabled = true;
      $('bar').style.display = $('ptext').style.display = 'block';
      $('bar-fill').style.width = '0'; $('bar-fill').style.background = '';
      $('ptext').textContent = 'Starting download...';
      try {
        const res = await fetch(`${OLLAMA_URL}/api/pull`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, stream: true })
        });
        if (!res.ok) throw new Error('pull failed');
        for await (const d of readNdjson(res)) {
          if (d.error) throw new Error(d.error);
          if (d.status) {
            let s = d.status;
            if (d.total && d.completed) { const p = Math.round(d.completed / d.total * 100); $('bar-fill').style.width = p + '%'; s += ` (${p}%)`; }
            $('ptext').textContent = s;
          }
        }
        $('ptext').textContent = 'Download complete'; $('bar-fill').style.width = '100%';
        await fetchModels();
        setTimeout(() => { closeModal(); resetModal(); }, 1400);
      } catch (e) {
        $('ptext').textContent = 'Download failed. Check the model name and your internet connection.';
        $('bar-fill').style.background = 'var(--danger)';
      } finally { $('pull').disabled = $('model-name').disabled = false; }
    };

    /* ---------- CPU / RAM / GPU meters (numbers come from Python) ---------- */
    function setStat(id, pct, text, tip) {
      const el = $(id);
      if (pct == null || isNaN(pct)) { el.hidden = true; return; }
      el.hidden = false;
      el.querySelector('i').style.width = Math.min(100, pct) + '%';
      el.classList.toggle('hot', pct > 85);
      el.querySelector('.sv').textContent = text;
      if (tip) el.title = tip;
    }
    let polling = false;
    async function pollStats() {
      const api = window.pywebview && window.pywebview.api;
      if (!api || !api.get_stats || polling) return; // not running inside the desktop app
      polling = true;
      try {
        const s = await api.get_stats();
        if (!s || !Object.keys(s).length) return;
        $('stats').hidden = false;
        setStat('st-cpu', s.cpu, Math.round(s.cpu) + '%');
        setStat('st-ram', s.ram_total ? s.ram_used / s.ram_total * 100 : null, s.ram_used?.toFixed(1) + ' / ' + Math.round(s.ram_total) + ' GB');
        setStat('st-gpu', s.gpu, Math.round(s.gpu) + '%', s.gpu_name);
        setStat('st-vram', s.vram_total ? s.vram_used / s.vram_total * 100 : null, s.vram_used?.toFixed(1) + ' / ' + s.vram_total?.toFixed(0) + ' GB', s.gpu_name);
      } catch (e) { console.error(e); }
      finally { polling = false; }
    }
    setInterval(pollStats, 1500);

    /* ---------- start ---------- */
    (function init() {
      let t = 'light';
      try { t = localStorage.getItem('kraken_theme2') || 'light'; } catch { }
      setTheme(t);
      load(); renderAll();
      checkOllama();
      setInterval(checkOllama, 5000);
    })();
  </script>
</body>

